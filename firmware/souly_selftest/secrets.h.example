/* ============================================================================
   secrets.h.example — copy this to secrets.h and fill it in.

   secrets.h is gitignored. This file is not, so it must never contain a real
   password or a real device key.
   ============================================================================ */

#pragma once

#define WIFI_SSID    "your-2.4GHz-network"   // an ESP32 has no 5GHz radio
#define WIFI_PASS    "your-password"

#define SERVER_HOST  "192.168.1.10"          // the laptop running run.bat
#define SERVER_PORT  8000

#define DEVICE_KEY   "dev_xxxxxxxxxxxxxxxx"  // python scripts/seed_classes.py
